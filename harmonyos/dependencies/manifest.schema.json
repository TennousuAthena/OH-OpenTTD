{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/OpenTTD/OpenTTD/harmonyos/dependencies/manifest.schema.json",
  "title": "OpenTTD HarmonyOS native dependency manifest",
  "description": "Governance schema for the pinned third-party native dependency graph of the OpenTTD HarmonyOS port. Every archive-source dependency MUST pin an immutable release URL and a verified SHA-256. Mutable branches (main/master/latest) are forbidden. NDK-provided components (Threads/libc++, Bionic) are recorded with source=ndk and null url/sha256; they are pinned by the API 23 toolchain manifest produced by scripts/harmonyos/bootstrap.sh.",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "openttdRelease",
    "runtimeAbis",
    "cachePolicy",
    "dependencies"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "openttdRelease": { "type": "string", "minLength": 1 },
    "openttdLicense": {
      "type": "object",
      "required": ["spdx", "file"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeAbis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["arm64-v8a", "x86_64"] }
    },
    "cachePolicy": {
      "type": "object",
      "required": ["envVar", "offlineEnvVar", "networkFallback"],
      "properties": {
        "envVar": { "const": "HARMONY_DEPS_CACHE" },
        "offlineEnvVar": { "const": "HARMONY_DEPS_OFFLINE" },
        "networkFallback": { "const": false }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/dependency" }
    }
  },
  "definitions": {
    "dependency": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "source",
        "license",
        "linkage",
        "abis",
        "updateOwner",
        "buildRole"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._+-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source": { "enum": ["archive", "ndk", "bundled-upstream"] },
        "url": {
          "type": ["string", "null"],
          "pattern": "^https://"
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "archive": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "license": {
          "type": "object",
          "required": ["spdx", "licenseFile"],
          "properties": {
            "spdx": { "type": "string", "minLength": 1 },
            "licenseFile": { "type": "string", "minLength": 1 }
          }
        },
        "linkage": {
          "enum": ["static", "shared", "system", "static+shared"]
        },
        "abis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["arm64-v8a", "x86_64"] }
        },
        "updateOwner": { "type": "string", "minLength": 1 },
        "buildRole": { "type": "string", "minLength": 1 },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tls": {
          "type": "object",
          "properties": {
            "backend": { "type": "string" },
            "trustStore": { "type": "string" }
          }
        },
        "optional": { "type": "boolean" },
        "excluded": { "type": "boolean" },
        "exclusionReason": { "type": "string" }
      }
    }
  }
}
