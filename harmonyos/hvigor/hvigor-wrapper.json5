  // toolchain contract verified by scripts/harmonyos/bootstrap.sh.
  "modelVersion": "5.0.0",
  "toolchain": {
    "hvigorVersion": "6.23.6",
    "apiVersion": "23",
    "sdkVersion": "6.1.0.105"
  }
}
